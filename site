    if(S.cat==='custom'){
      $('pick').style.maxHeight='none';
      $('pick').innerHTML='<div class="cust"><label for="cn">Drink name<input id="cn" type="text" placeholder="e.g. Oat cortado" maxlength="40"></label><label for="cm">Caffeine in mg<input id="cm" type="number" min="1" max="2000" step="1" placeholder="e.g. 120"></label><button class="go" id="cadd" aria-label="Add custom drink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button></div>';
      return;
    }
    $('pick').style.maxHeight='';
    $('pick').innerHTML=D.filter(function(d){return d.cat===S.cat}).map(function(d){
      var i0=d.cat==='sbux'&&d.sizes.length>2?2:0;
      var sel=d.sizes.length>1?'<select id="sz-'+d.id+'" data-sz="'+d.id+'" aria-label="Size for '+esc(d.name)+'">'+d.sizes.map(function(s,i){return '<option value="'+i+'"'+(i===i0?' selected':'')+'>'+s[0]+'</option>'}).join('')+'</select>':'<span style="font-size:13px;color:var(--muted);font-weight:700">'+d.sizes[0][0]+'</span>';
      return '<div class="drink"><span class="ico">'+svg(d.kind,d.color,34)+'</span><div class="dn"><b>'+esc(d.name)+'</b>'+(d.note?'<span>'+esc(d.note)+'</span>':'')+'</div>'+sel+'<output class="mg" id="mg-'+d.id+'">'+d.sizes[i0][1]+' mg</output><button class="go" data-add="'+d.id+'" aria-label="Add '+esc(d.name)+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button></div>';
    }).join('');
  }
  function renderNotes(){
    var g=guidance(),mg=total(),n=[];
    function P(t,w){n.push({t:t,w:w})}
    var en=S.log.some(function(x){return D.some(function(d){return d.id===x.id&&d.energy})});
    if(mg>g.s&&g.s>0)P('You are '+(mg-g.s)+' mg over your suggested amount. Caffeine from coffee usually peaks in your blood in about an hour, and responses vary from person to person.',true);
    else if(mg>0&&g.s===0)P('Caffeine is not recommended for children under 12.',true);
    else P('Caffeine from coffee usually peaks in your blood in about an hour. Responses vary with genes, age and tolerance.');
    if(en)P('Energy drinks: the AHA statement says data are limited and generally point to cardiovascular harm. They raised blood pressure in healthy adults.',true);
    if(S.log.some(function(x){return D.some(function(d){return d.id===x.id&&d.unfiltered})}))P('Unfiltered coffee (French press, Turkish, boiled, espresso) contains cafestol, which raises LDL cholesterol. Paper-filtered and instant coffee do not.');
    if(S.pz){
      if(S.age==='teen')P('Teens 12 to 18: AACAP recommends 100 mg a day or less.');
      if(S.age==='child')P('Children under 12 should avoid caffeine.',true);
      if(S.preg)P('Pregnancy: ACOG recommends staying under 200 mg a day. Caffeine crosses the placenta.');
      if(S.bp)P('High blood pressure: the AHA says high caffeine doses can raise blood pressure significantly, especially with hypertension. Ask your doctor what suits you.');
      if(S.diab){var sg=S.log.filter(function(x){return D.some(function(d){return d.id===x.id&&d.sugary})}).length;
        P('Diabetes: regular coffee drinkers had about 20% lower type 2 diabetes risk at roughly 3.5 cups a day, and decaf showed similar benefit. Added sugar and syrups can offset that.'+(sg?' You logged '+sg+' sweetened '+(sg>1?'drinks':'drink')+' today.':''),sg>0);}
      if(S.rhythm)P('Heart rhythm: in a randomized trial of people treated for AF, continuing coffee lowered the chance AF came back. Coffee may add extra beats from the lower chambers (PVCs), and very high caffeine doses have been linked to rhythm problems, even in healthy adults under 30.',en);
      if(S.sleep){var late=S.log.some(function(x){return new Date(x.t).getHours()>=14});
        P(late?'You had caffeine in the afternoon. Caffeine can get in the way of sleep, so consider stopping earlier in the day.':'For sleep: caffeine can keep you awake, so it helps to cut caffeinated drinks late in the day.',late);}
    } else if(mg>0){P('Showing general adult guidance. If you are pregnant, under 18, or have a heart or blood pressure condition, turn on personalization.');}
    n=n.filter(function(x){return x.w}).concat(n.filter(function(x){return !x.w}));
    function li(x){return '<li'+(x.w?' class="warn"':'')+'>'+esc(x.t)+'</li>'}
    $('notes').innerHTML=n.slice(0,2).map(li).join('');
    var rest=n.slice(2);$('moreNotes').hidden=!rest.length;
    $('notes2').innerHTML=rest.map(li).join('');
    $('moreSum').textContent='See '+rest.length+' more';
  }
  function renderPz(){
    $('pz').checked=S.pz;$('pzBox').setAttribute('aria-disabled',String(!S.pz));
    ['age','goal'].forEach(function(k){$(k).disabled=!S.pz;$(k).value=S[k];});
    [['c-preg','preg'],['c-bp','bp'],['c-diab','diab'],['c-rhythm','rhythm'],['c-sleep','sleep']].forEach(function(p){$(p[0]).disabled=!S.pz;$(p[0]).checked=S[p[1]];});
  }
  function renderAll(){renderHero();renderLog();renderNotes();}

  var FACTS=[
    ['Caffeine is not the whole story','You might expect caffeine to be what matters. But decaf coffee, which has almost no caffeine, was linked to a similar lower risk of type 2 diabetes. In the AHA review, regular coffee drinkers had about 20% lower risk at around 3.5 cups a day and about 30% lower at around 5 cups. Because decaf worked too, other natural compounds in coffee are probably doing part of the job. This comes from observational studies, so it shows a link, not proof.'],
    ['How you brew matters','French press, Turkish, boiled coffee and espresso can raise LDL cholesterol. Paper filters catch the cause, cafestol.'],
    ['Energy drinks are different','They raised blood pressure more than coffee, and very high doses have been linked to rhythm problems, even in healthy adults under 30.'],
    ['The sweet spot is moderate','Heart disease and stroke risk looked lowest at about 2 to 4 cups a day. Stroke risk was about 21% lower at 3 to 4 cups. Most of this evidence is observational.'],
    ['One hour to peak','Caffeine from coffee usually peaks in your blood in about an hour. How fast you clear it varies with genes, age and tolerance.'],
    ['Your genes set your speed','Variants in genes like CYP1A2 change how you process caffeine, so some people feel small amounts for longer.'],
    ['Good news for rhythm, with a catch','In people treated for AF, continuing coffee cut the risk of AF coming back by 39% in a randomized trial. Randomized trials also suggest coffee can add extra heartbeats (PVCs).'],
    ['Extreme doses are risky','Rare cases of dangerous heart rhythms and cardiac arrest have been reported after extremely high caffeine intake.'],
    ['Sugar changes the picture','The AHA calls up to 400 mg a day safe for most adults when the coffee has no added sugar or fillers.']
  ];
  $('facts').innerHTML=FACTS.map(function(f){return '<details class="fact"><summary>'+f[0]+'</summary><p>'+f[1]+'</p></details>'}).join('');

  /* ---------- events ---------- */
  function react(name){
    tmpBubble='Mmm, '+name.split(' (')[0].toLowerCase().slice(0,26)+'!';
    clearTimeout(tmpTimer);tmpTimer=setTimeout(function(){tmpBubble=null;renderHero();},2400);
    var b=$('bubble');b.classList.remove('hop');void b.offsetWidth;b.classList.add('hop');
  }
  function reduced(){try{return window.matchMedia('(prefers-reduced-motion: reduce)').matches}catch(e){return false}}
  function go(id){var el=$(id);if(el)el.scrollIntoView({behavior:reduced()?'auto':'smooth',block:id==='home'?'start':'start'});}
  document.addEventListener('click',function(e){
    var t=e.target.closest('button');if(!t)return;
    if(t.dataset.go){go(t.dataset.go);return;}
    if(t.dataset.cat){S.cat=t.dataset.cat;save();renderTiles();renderPick();return;}
    if(t.dataset.add){
      var d=D.filter(function(x){return x.id===t.dataset.add})[0];var sel=$('sz-'+d.id);var i=sel?parseInt(sel.value,10):0;
      if(S.log.some(function(x){return x.ex}))S.log=[];S.ex=false;
      S.log.push({id:d.id,name:d.name,size:d.sizes[i][0],mg:d.sizes[i][1],kind:d.kind,color:d.color,t:Date.now()});
      react(d.name);save();renderAll();go('home');return;}
    if(t.id==='cadd'){var mg=parseFloat($('cm').value);if(!(mg>0&&mg<=2000)){$('cm').focus();return;}
      var nm=($('cn').value||'Custom drink').trim()||'Custom drink';
      if(S.log.some(function(x){return x.ex}))S.log=[];S.ex=false;
      S.log.push({id:'custom',name:nm,size:'Custom',mg:Math.round(mg),kind:'cup',color:'#B07A4A',t:Date.now()});
      $('cn').value='';$('cm').value='';react(nm);save();renderAll();go('home');return;}
    if(t.dataset.rm!==undefined){S.log.splice(parseInt(t.dataset.rm,10),1);if(!S.log.length)S.ex=false;save();renderAll();return;}
    if(t.id==='clear'){S.log=[];S.ex=false;save();renderAll();}
  });
  document.addEventListener('change',function(e){
    var t=e.target;
    if(t.dataset&&t.dataset.sz){var d=D.filter(function(x){return x.id===t.dataset.sz})[0];$('mg-'+d.id).textContent=d.sizes[parseInt(t.value,10)][1]+' mg';return;}
    if(t.id==='pz'){S.pz=t.checked;if(S.pz)$('gd').open=true;}
    else if(t.id==='age'){S.age=t.value;}
    else if(t.id==='goal'){S.goal=t.value;}
    else if(t.id.indexOf('c-')===0){S[t.id.slice(2)]=t.checked;}
    else return;
    save();renderPz();renderAll();
  });
  $('goal').addEventListener('input',function(){S.goal=this.value;save();renderAll();});

  /* dock highlight */
  var IDS=['home','street','journal','office','library'];
  function onScroll(){
    var y=window.innerHeight*0.45,cur='home';
    IDS.forEach(function(id){var r=$(id).getBoundingClientRect();if(r.top<=y)cur=id;});
    document.querySelectorAll('.dk').forEach(function(b){b.setAttribute('aria-current',String(b.dataset.go===cur));});
  }
  window.addEventListener('scroll',onScroll,{passive:true});

  load();renderTiles();renderPick();renderPz();renderAll();onScroll();
})();
</script>

</html>

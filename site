  function exampleLog(){
    var d=new Date();var a=new Date(d.getFullYear(),d.getMonth(),d.getDate(),8,10).getTime();var b=new Date(d.getFullYear(),d.getMonth(),d.getDate(),10,40).getTime();
    function mk(id,si,t){var x=D.filter(function(q){return q.id===id})[0];return {id:id,name:x.name,size:x.sizes[si][0],mg:x.sizes[si][1],kind:x.kind,color:x.color,t:t,ex:true};}
    return [mk('brew',0,a),mk('matchal',2,b)];
  }
  function load(){
    try{var r=JSON.parse(localStorage.getItem(KEY)||'null');if(r){for(var k in S)if(k in r&&k!=='log'&&k!=='ex')S[k]=r[k];
      if(r.day===today()){S.log=r.log||[];S.ex=!!r.ex;}else{S.log=[];S.ex=false;} return;}}catch(e){}
    S.log=exampleLog();S.ex=true;
  }
  function save(){try{var o={};for(var k in S)o[k]=S[k];o.day=today();localStorage.setItem(KEY,JSON.stringify(o));}catch(e){}}

  function guidance(){
    var gen='General adult guidance: up to about 400 mg a day (AHA statement, FDA)';
    if(!S.pz)return {s:400,rows:[{v:400,t:gen,bind:true}]};
    var goal=parseFloat(S.goal);
    if(!isNaN(goal)&&S.goal!==''&&goal>=0)return {s:goal,rows:[{v:goal,t:'Your own goal',bind:true}],own:true};
    var rows=[{v:400,t:gen}];
    if(S.age==='senior')rows.push({v:400,t:'65 and over: the sources used here give no separate figure, so adult guidance applies'});
    if(S.age==='teen')rows.push({v:100,t:'Ages 12 to 18: 100 mg a day (AACAP)'});
    if(S.age==='child')rows.push({v:0,t:'Under 12: avoid caffeine, no known safe amount'});
    if(S.preg)rows.push({v:200,t:'Pregnancy: under 200 mg a day (ACOG)'});
    var s=Math.min.apply(null,rows.map(function(r){return r.v}));
    var bound=false;rows.forEach(function(r){if(r.v===s&&!bound){r.bind=true;bound=true;}});
    return {s:s,rows:rows};
  }

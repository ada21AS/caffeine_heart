    $('mgTotal').textContent=mg;$('mgTotal2').textContent=mg;
    $('ofLine').textContent=g.s>0?('of '+g.s+' mg '+(g.own?'goal':'suggested')):'No caffeine suggested';
    $('statePill').textContent=STATE[st.name].pill;
    var pct=Math.max(st.r*100,0);$('barFill').style.width=Math.min(100,pct)+'%';$('bar').className='bar'+(st.r>1?' over':'');
    $('sumv').textContent=g.s+' mg suggested'+(S.pz?' · personalized':'');
    var b=$('bubble');b.textContent=tmpBubble||bubbleText(st.name,mg,g);
    var last=S.log[S.log.length-1];
    $('held').innerHTML=last?'<g class="pop">'+ico(last.kind,last.color)+'</g>':'';
    var prev=S.log.slice(0,-1).reverse(),o='';
    prev.slice(0,SLOTS.length).forEach(function(it,i){var p=SLOTS[i];o+='<g transform="translate('+p[0]+','+p[1]+') scale(.6)">'+ico(it.kind,it.color)+'</g>';});

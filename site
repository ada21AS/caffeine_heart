<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Caffeine Heart: a mini website that tracks your caffeine, sip by sip, with a heart that reacts. Based on the American Heart Association scientific statement on caffeine and cardiovascular disease.">
<meta name="theme-color" content="#FFF3DF">
<meta property="og:title" content="Caffeine Heart">
<meta property="og:description" content="Track your caffeine, sip by sip, and watch a little heart react.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath d='M24 42 C10 33 4 24 7 15 C9 8 19 7 24 14 C29 7 39 8 41 15 C44 24 38 33 24 42Z' fill='%23E43D35'/%3E%3Ccircle cx='19' cy='22' r='2.6' fill='%231b1010'/%3E%3Ccircle cx='29' cy='22' r='2.6' fill='%231b1010'/%3E%3C/svg%3E">
<title>Caffeine Heart</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap">
<style>
/* Concept: the whole page is one small world. A landscape hero changes mood with caffeine level,
   the page scrolls down into a street of shops, a health office, a notebook and a signpost library.
   Controls follow the reference: soft white floating dock with a dark rounded-square primary button. */
@property --sky1{syntax:'<color>';inherits:true;initial-value:#8FD0EC}
@property --sky2{syntax:'<color>';inherits:true;initial-value:#E3F6FB}
@property --sun{syntax:'<color>';inherits:true;initial-value:#FFE08A}
@property --mtn1{syntax:'<color>';inherits:true;initial-value:#8FA8E0}
@property --mtn2{syntax:'<color>';inherits:true;initial-value:#B7C6F0}
@property --hill1{syntax:'<color>';inherits:true;initial-value:#CFE9D5}
@property --hill2{syntax:'<color>';inherits:true;initial-value:#B5DDBF}
@property --hill3{syntax:'<color>';inherits:true;initial-value:#9ED0AB}
@property --cloud{syntax:'<color>';inherits:true;initial-value:#FFFFFF}
@property --tree{syntax:'<color>';inherits:true;initial-value:#2B5A63}
@property --sea{syntax:'<color>';inherits:true;initial-value:#4FB6D9}
@property --bridge{syntax:'<color>';inherits:true;initial-value:#E4553F}
@property --title{syntax:'<color>';inherits:true;initial-value:#2E4A9E}

:root{
  --bg:#FFF3DF; --surface:#FFFFFF; --ink:#12303B; --muted:#5E6E78; --line:#EFDFC3; --soft:#FBF1DE;
  --aqua:#0B97AE; --aqua-ink:#FFFFFF; --btn:#1D2B33; --btn-ink:#FFFFFF;
  --info-bg:#E6F3F8; --info-ink:#17434F; --warn-bg:#FFF1D6; --warn-ink:#6B4300;
  --shadow:0 18px 44px rgba(150,90,30,.16);
  --display:'Fredoka','Nunito',system-ui,sans-serif; --body:'Nunito',system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E1A24; --surface:#16293A; --ink:#E7F1F5; --muted:#94AEBB; --line:#27414F; --soft:#1D3446;
  --aqua:#3CCBE6; --aqua-ink:#06242C; --btn:#EAF3F6; --btn-ink:#0E2430;
  --info-bg:#173F4B; --info-ink:#C9EAF2; --warn-bg:#3B2E10; --warn-ink:#FBD89A; --shadow:0 18px 44px rgba(0,0,0,.4); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E1A24; --surface:#16293A; --ink:#E7F1F5; --muted:#94AEBB; --line:#27414F; --soft:#1D3446;
  --aqua:#3CCBE6; --aqua-ink:#06242C; --btn:#EAF3F6; --btn-ink:#0E2430;
  --info-bg:#173F4B; --info-ink:#C9EAF2; --warn-bg:#3B2E10; --warn-ink:#FBD89A; --shadow:0 18px 44px rgba(0,0,0,.4); color-scheme:dark}

*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5;
  padding-left:0;padding-right:0;padding-top:0;padding-bottom:120px;overflow-x:hidden}
h1,h2,h3{font-family:var(--display);font-weight:600;margin:0;text-wrap:balance}
h2{font-size:22px}
button,select,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--aqua);outline-offset:2px}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* ===== world hero ===== */
.world{position:relative;display:flex;flex-direction:column;align-items:center;min-height:clamp(720px,100svh,900px);padding-bottom:104px;overflow:hidden;
  --sky1:#5EC3F2;--sky2:#FFF0D6;--sun:#FFD66B;--mtn1:#EBC27A;--mtn2:#D9A25E;--sea:#4FB6D9;--bridge:#E4553F;--hill1:#E9D79C;--hill2:#A9D18A;--hill3:#86BE72;--cloud:#FFFFFF;--tree:#2F8F6B;--title:#2A4BA0;
  transition:--sky1 1.2s,--sky2 1.2s,--sun 1.2s,--mtn1 1.2s,--mtn2 1.2s,--sea 1.2s,--bridge 1.2s,--hill1 1.2s,--hill2 1.2s,--hill3 1.2s,--cloud 1.2s,--tree 1.2s,--title 1.2s}
.world[data-state="perky"]{--sky1:#4FB9F5;--sky2:#FFE8B8;--sun:#FFC93C;--mtn1:#F0B866;--mtn2:#E09A4F;--sea:#3FA9E0;--hill1:#EBD38A;--hill2:#A2D17E;--hill3:#7DBB63;--title:#2F4AB8}
.world[data-state="buzz"]{--sky1:#FF8A5B;--sky2:#FFD98A;--sun:#FF5E3A;--mtn1:#DE8A5E;--mtn2:#BD6A4B;--sea:#E9856E;--bridge:#B02E2A;--hill1:#F0C27A;--hill2:#C9B25E;--hill3:#A99A4C;--cloud:#FFE9C9;--tree:#7A3B2E;--title:#B83A1A}
.world[data-state="sick"]{--sky1:#A9B59A;--sky2:#DADFC4;--sun:#CBD59A;--mtn1:#B8B38A;--mtn2:#98A07A;--sea:#8DA79A;--bridge:#A5593F;--hill1:#C5C79A;--hill2:#A3B685;--hill3:#8CA373;--cloud:#A9B3A5;--tree:#3C5A44;--title:#4B6B3A}
.scene{position:absolute;inset:0;width:100%;height:100%}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .scene{filter:brightness(.6) saturate(.85)}}
:root[data-theme="dark"] .scene{filter:brightness(.6) saturate(.85)}
.cl{animation:drift 26s ease-in-out infinite alternate}
.cl.c2{animation-duration:34s;animation-direction:alternate-reverse}
.cl.c3{animation-duration:30s}
@keyframes drift{from{transform:translateX(-60px)}to{transform:translateX(60px)}}
.sunrays{transform-box:fill-box;transform-origin:center;animation:spin 60s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.rain{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity 1s;
  background:repeating-linear-gradient(100deg,rgba(255,255,255,.0) 0 14px,rgba(255,255,255,.35) 14px 15px,rgba(255,255,255,0) 15px 34px);background-size:200px 200px;animation:rain .5s linear infinite}
@keyframes rain{to{background-position:-60px 200px}}
.world[data-state="sick"] .rain{opacity:.55}
.top{position:absolute;top:max(14px,env(safe-area-inset-top,0px));left:0;right:0;display:flex;align-items:center;gap:10px;z-index:3}
.logo{display:flex;align-items:center;gap:8px;font-family:var(--display);font-weight:600;font-size:19px;color:#12303B;background:rgba(255,255,255,.7);padding:6px 14px 6px 8px;border-radius:99px;backdrop-filter:blur(6px)}
.hero-text{position:relative;width:100%;margin-top:max(74px,9vh);padding-bottom:46px;text-align:center;z-index:1}
.giant{font-family:var(--display);font-weight:700;line-height:.9;font-size:clamp(92px,24vw,190px);color:var(--title);
  text-shadow:.035em .045em 0 rgba(255,255,255,.95);letter-spacing:-.01em;font-variant-numeric:tabular-nums}
.giant small{font-size:.32em;margin-left:.1em;letter-spacing:.04em}
:root[data-theme="dark"] .giant{color:#DCE8FF;text-shadow:.035em .045em 0 rgba(8,16,32,.6)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .giant{color:#DCE8FF;text-shadow:.035em .045em 0 rgba(8,16,32,.6)}}
.pillrow{display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap;margin-top:6px}
.pill{font-weight:800;font-size:13px;letter-spacing:.07em;text-transform:uppercase;padding:5px 13px;border-radius:99px;background:#1D2B33;color:#fff}
.of{font-weight:800;font-size:15px;color:#12303B;background:rgba(255,255,255,.9);padding:4px 12px;border-radius:99px}
.bar{width:min(300px,72vw);height:12px;border-radius:99px;background:rgba(255,255,255,.85);box-shadow:0 2px 8px rgba(20,40,80,.15);margin:10px auto 0;overflow:hidden}
.bar i{display:block;height:100%;width:0;border-radius:99px;background:#1D2B33;transition:width .9s cubic-bezier(.3,.8,.3,1)}
.bar.over i{background:#C2392F}
.heartwrap{position:relative;margin-top:auto;width:min(80vw,380px);z-index:2}
#heart{width:100%;display:block;overflow:visible}
.bubble{position:absolute;left:62%;top:-4%;max-width:48%;background:#fff;color:#12303B;border-radius:18px;padding:8px 14px;font-family:var(--display);font-weight:500;font-size:16px;line-height:1.2;box-shadow:0 8px 22px rgba(20,40,80,.2);z-index:3;transition:transform .3s}
.bubble::after{content:"";position:absolute;left:-8px;bottom:12px;width:16px;height:16px;background:#fff;transform:rotate(45deg);border-radius:3px}
.bubble.hop{animation:hop .4s cubic-bezier(.3,1.6,.5,1)}
@keyframes hop{from{transform:scale(.6)}}

/* heart paint + motion */
#heart .body{fill:url(#gRed);transition:fill .5s}
#heart[data-state="buzz"] .body{fill:url(#gHot)}
#heart[data-state="sick"] .body{fill:url(#gGreen)}
#heart{--h2:#CF3743;--h3:#DA3F4B}
#heart[data-state="buzz"]{--h2:#C42F3A;--h3:#D3414A}
#heart[data-state="sick"]{--h2:#729C50;--h3:#7CA45A}
.limb{stroke:var(--h2);transition:stroke .5s}
.foot{fill:var(--h2);transition:fill .5s}
.hand{fill:var(--h3);transition:fill .5s}
.f{display:none}
#heart[data-state="calm"] .f-calm,#heart[data-state="perky"] .f-perky,#heart[data-state="buzz"] .f-buzz,#heart[data-state="sick"] .f-sick{display:block}
.beat{transform-box:fill-box;transform-origin:50% 55%;animation:beat var(--dur,1.3s) ease-in-out infinite}
@keyframes beat{0%,100%{transform:scale(1)}14%{transform:scale(1.04)}28%{transform:scale(1)}42%{transform:scale(1.028)}}
#heart[data-state="buzz"] .char{animation:shake .14s linear infinite}
#heart[data-state="sick"] .char{animation:sway 2.4s ease-in-out infinite;transform-box:fill-box;transform-origin:50% 100%}
@keyframes shake{0%,100%{transform:translate(0,34px)}25%{transform:translate(1.6px,33px)}75%{transform:translate(-1.6px,35px)}}
@keyframes sway{0%,100%{transform:translate(0,34px) rotate(-2deg)}50%{transform:translate(0,34px) rotate(2deg)}}
.pop{animation:pop .45s cubic-bezier(.3,1.6,.5,1);transform-box:fill-box;transform-origin:50% 100%}
@keyframes pop{from{transform:scale(.3);opacity:0}}
@media (prefers-reduced-motion:reduce){.beat,.char,.cl,.sunrays,.rain,.pop,.bubble.hop{animation:none!important}.bar i{transition:none}}

/* ===== sheet ===== */
.sheet{position:relative;z-index:4;margin-top:-96px;display:grid;gap:34px;max-width:760px;margin-left:auto;margin-right:auto}
.card{background:var(--surface);border-radius:30px;padding:20px;box-shadow:var(--shadow);position:relative}
.hint{color:var(--muted);font-size:13px;margin:2px 0 0}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.go{width:46px;height:46px;border-radius:15px;border:0;background:var(--btn);color:var(--btn-ink);display:grid;place-items:center;cursor:pointer;flex:none;transition:transform .15s}
.go:active{transform:scale(.92)}
.go svg{width:20px;height:20px}
.soft{border:0;background:var(--soft);border-radius:14px;padding:9px 14px;font-weight:700;cursor:pointer}

/* shop street */
.street{margin-top:20px}
.awning{position:absolute;left:14px;right:14px;top:-22px;height:26px;border-radius:12px 12px 0 0;background:repeating-linear-gradient(90deg,#FF6F59 0 28px,#FFF6E0 28px 56px)}
.awning::after{content:"";position:absolute;left:0;right:0;top:100%;height:14px;
  background:radial-gradient(circle at 14px 0,#FF6F59 14px,#0000 15px) 0 0/56px 14px repeat-x,radial-gradient(circle at 42px 0,#FFF6E0 14px,#0000 15px) 0 0/56px 14px repeat-x}
.tiles{display:flex;gap:10px;overflow-x:auto;padding:22px 4px 12px;margin:0 -4px;scroll-snap-type:x proximity}
.tile{flex:none;scroll-snap-align:start;width:104px;border:0;background:var(--soft);border-radius:22px;padding:8px 6px 10px;cursor:pointer;display:grid;justify-items:center;gap:2px;font-weight:800;font-size:12.5px;transition:transform .2s,box-shadow .2s}
.tile[aria-pressed="true"]{background:var(--surface);box-shadow:0 0 0 3px var(--aqua),0 10px 22px rgba(13,169,204,.25);transform:translateY(-4px)}
.tile svg{width:84px;height:84px}
.list{display:grid;gap:8px;max-height:360px;overflow-y:auto;padding:2px 4px 2px 0;margin-top:6px}
.drink{display:grid;grid-template-columns:44px minmax(0,1fr) auto auto auto;gap:10px;align-items:center;padding:8px 10px 8px 8px;border-radius:20px;background:var(--soft)}
.drink .dn{min-width:0;line-height:1.25}
.drink .dn b{display:block;font-size:14.5px}
.drink .dn span{font-size:12px;color:var(--muted)}
.ico{width:44px;height:44px;border-radius:14px;background:#EAF6F8;display:grid;place-items:center}
.drink select,.cust input{border:0;background:var(--surface);border-radius:12px;padding:8px 10px;max-width:150px;box-shadow:0 1px 0 var(--line)}
.mg{font-family:var(--display);font-weight:600;min-width:62px;text-align:right;font-variant-numeric:tabular-nums}
.cust{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end}
.cust label{display:grid;gap:4px;font-weight:700;font-size:13px}
.cust input{max-width:none;width:100%}

/* journal (notebook) */
.journal{padding-left:44px;background-image:radial-gradient(circle at 20px 30px,var(--bg) 6px,#0000 7px);background-size:40px 44px;background-repeat:repeat-y;background-color:var(--surface)}
.logrow{display:grid;grid-template-columns:40px minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1.5px dashed var(--line)}
.logrow:last-of-type{border:0}
.logrow small{color:var(--muted);display:block}
.logrow .ico{width:40px;height:40px}
.x{position:relative;border:0;background:var(--soft);color:var(--muted);width:30px;height:30px;border-radius:10px;font-size:18px;line-height:1;cursor:pointer}
.tot{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-family:var(--display);font-size:20px;font-weight:600}
.banner{background:var(--info-bg);color:var(--info-ink);border-radius:16px;padding:10px 12px;margin-bottom:10px;display:flex;gap:10px;justify-content:space-between;align-items:center;flex-wrap:wrap}
.tagex{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;background:var(--info-bg);color:var(--info-ink);border-radius:6px;padding:1px 6px;margin-left:6px}
.empty{color:var(--muted);margin:0}

/* health office */
.office{margin-top:14px}
.roof{position:absolute;left:5%;right:5%;top:-34px;height:36px;background:var(--btn);clip-path:polygon(0 100%,7% 0,93% 0,100% 100%);display:grid;place-items:center}
.roof span{color:var(--btn-ink);font-family:var(--display);font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin-top:4px}
.sum{display:flex;justify-content:space-between;align-items:center;gap:10px;cursor:pointer;list-style:none;font-family:var(--display);font-weight:600;font-size:22px}
.sum::-webkit-details-marker{display:none}
.sum::after{content:"+";font-size:24px;color:var(--aqua);margin-left:auto;padding-left:8px}
details[open]>.sum::after{content:"\2212"}
.sumv{font-family:var(--body);font-size:13px;font-weight:800;color:var(--muted)}
.sw{display:flex;align-items:center;gap:12px;font-weight:800;cursor:pointer}
.sw input{position:absolute;opacity:0;pointer-events:none}
.sw .trk{width:50px;height:30px;border-radius:99px;background:var(--line);position:relative;transition:background .2s;flex:none}
.sw .trk::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.sw input:checked+.trk{background:var(--aqua)}
.sw input:checked+.trk::after{transform:translateX(20px)}
.sw input:focus-visible+.trk{outline:3px solid var(--aqua);outline-offset:2px}
.pz{display:grid;gap:14px;margin-top:14px}
.pz[aria-disabled="true"]{opacity:.45;pointer-events:none}
.pz label.f1{display:grid;gap:4px;font-weight:700;font-size:13px}
.pz select,.pz input[type=number]{border:0;background:var(--soft);border-radius:14px;padding:10px 12px;width:100%;max-width:340px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{position:relative}
.chip input{position:absolute;opacity:0}
.chip span{display:inline-block;background:var(--soft);border-radius:99px;padding:7px 14px;font-weight:700;cursor:pointer}
.chip input:checked+span{background:var(--aqua);color:var(--aqua-ink)}
.chip input:focus-visible+span{outline:3px solid var(--aqua);outline-offset:2px}
.why{margin:12px 0 0;padding:12px 14px;border-radius:18px;background:var(--info-bg);color:var(--info-ink);font-size:14px}
.why b{font-family:var(--display);font-size:17px}
.why ul{margin:6px 0 0;padding-left:18px}
.why li.bind{font-weight:800}
.tips{margin-top:16px}
.tips h3{font-size:17px;margin-bottom:8px}
.notes{display:grid;gap:8px;margin:0;padding:0;list-style:none}
.notes li{padding:10px 12px;border-radius:16px;background:var(--info-bg);color:var(--info-ink);font-size:14px}
.notes li.warn{background:var(--warn-bg);color:var(--warn-ink)}
.more{cursor:pointer;font-weight:800;color:var(--aqua);margin-top:10px;list-style:none}
.more::-webkit-details-marker{display:none}

/* library: signposts */
.lib h2{margin:0 4px 4px}
.signs{display:grid;gap:10px;margin-top:12px}
details.fact summary{list-style:none;cursor:pointer;font-family:var(--display);font-weight:600;font-size:17px;color:#3A2410;
  background:linear-gradient(180deg,#F0D6A6,#E2B976);padding:12px 44px 12px 18px;position:relative;
  clip-path:polygon(0 0,94% 0,100% 50%,94% 100%,0 100%);box-shadow:0 6px 0 rgba(0,0,0,.12)}
details.fact summary::-webkit-details-marker{display:none}
details.fact summary::after{content:"+";position:absolute;right:26px;top:50%;transform:translateY(-52%);font-size:22px}
details.fact[open] summary::after{content:"\2212"}
details.fact:nth-child(odd) summary{margin-right:10%}
details.fact:nth-child(even) summary{margin-left:10%}
details.fact p{margin:8px 14px 2px;color:var(--muted);font-size:14px}
.post{width:10px;background:#B68A4C;border-radius:4px;display:none}

footer{margin-top:10px;color:var(--muted);font-size:13px;display:grid;gap:8px;text-align:center}
footer details{text-align:left}
footer details summary{cursor:pointer;font-weight:800;color:var(--ink);text-align:center}
footer a{color:var(--aqua)}
footer ul{margin:6px 0 0;padding-left:18px}
.ground{display:block;width:100%;height:70px;margin-bottom:-4px}

/* ===== dock ===== */
.dock{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:30;
  display:flex;align-items:center;gap:6px;padding:8px;border-radius:32px;background:var(--surface);box-shadow:0 18px 44px rgba(20,40,80,.28)}
.dk{width:46px;height:46px;border-radius:15px;border:0;background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--muted);transition:background .2s,color .2s}
.dk svg{width:22px;height:22px}
.dk[aria-current="true"]{background:var(--soft);color:var(--aqua)}
.sep{width:1.5px;height:30px;background:var(--line);margin:0 4px}
.dock .go{width:52px;height:52px;border-radius:17px}

@media (max-width:560px){
  .drink{grid-template-columns:44px minmax(0,1fr) auto}
  .drink select{grid-column:2/3;max-width:none;width:100%}
  .drink .mg{grid-column:2/3;text-align:left}
  .drink .go{grid-column:3/4;grid-row:1/4;align-self:center}
  .bubble{font-size:14px;left:56%}
}

/* ===== iPhone / touch polish ===== */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{-webkit-tap-highlight-color:transparent;padding-bottom:calc(120px + env(safe-area-inset-bottom,0px))}
button,summary,label.chip,.tile,.dk,.go,.soft{touch-action:manipulation;-webkit-touch-callout:none}
button{-webkit-appearance:none;appearance:none}
.sheet{grid-template-columns:minmax(0,1fr)}
.sheet>*,.card{min-width:0}
.tiles{-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.list{overscroll-behavior:contain}
.world{min-height:clamp(720px,100svh,900px)}
@supports (height:100dvh){.world{min-height:clamp(720px,100dvh,900px)}}
@media (max-width:820px){
  /* 16px+ stops iOS Safari zooming the page when a field is focused */
